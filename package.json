{
  "name": "visit-quote-service",
  "version": "1.0.0",
  "private": true,
  "description": "Turns a quote request from the Impact Kit quiz into a Shopify draft order and a quote email.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.2"
  }
}
