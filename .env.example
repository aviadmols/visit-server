# Server
PORT=3000
# Storefront origins allowed to post a quote. Empty allows any origin.
ALLOWED_ORIGINS=https://shop.visit.org,https://visitorg.myshopify.com
# Optional shared secret. When set, requests must send it as the x-quote-token header.
QUOTE_API_TOKEN=

# Shopify app (Settings > Apps > Develop apps > Build apps in Dev Dashboard)
# Scopes: write_draft_orders, read_customers, write_customers
SHOPIFY_SHOP=visitorg.myshopify.com
# Dev Dashboard app: its Client ID and Client secret. The service fetches and renews the token itself.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or, for a legacy custom app created in admin before January 2026, its fixed token instead
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Customer metafield that holds the link to the latest quote
SHOPIFY_METAFIELD_NAMESPACE=visit
SHOPIFY_METAFIELD_KEY=last_quote_url
SHOPIFY_METAFIELD_TYPE=url
# Comma separated, added to every draft order
SHOPIFY_DRAFT_ORDER_TAGS=quote-quiz

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Visit.org <quotes@visit.org>
MAIL_REPLY_TO=
MAIL_SUBJECT=Your Impact Kit quote

# Email branding
BRAND_NAME=Visit.org
BRAND_URL=https://shop.visit.org
BRAND_SUPPORT_EMAIL=

# Log: one JSON line per record, emptied once it holds LOG_MAX_RECORDS lines
LOG_FILE=logs/quotes.log
LOG_MAX_RECORDS=100
