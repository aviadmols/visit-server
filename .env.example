# Server
PORT=3000
# Storefront origins allowed to post a quote. Empty allows any origin; * stands for one subdomain label.
ALLOWED_ORIGINS=https://shop.visit.org,https://visitorg.myshopify.com,https://*.shopifypreview.com
# Optional shared secret. When set, requests must send it as the x-quote-token header.
QUOTE_API_TOKEN=

# Shopify app (Settings > Apps > Develop apps > Build apps in Dev Dashboard)
# Scopes: write_draft_orders, read_customers, write_customers
SHOPIFY_SHOP=visitorg.myshopify.com
# Dev Dashboard app: its Client ID and Client secret. The service fetches and renews the token itself.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Or a fixed token: from a legacy custom app, or the one shown after installing at /auth/install
SHOPIFY_ADMIN_TOKEN=
# Public address of this service, for the install redirect. Railway fills it in on its own.
PUBLIC_URL=
SHOPIFY_SCOPES=write_draft_orders,read_customers,write_customers
SHOPIFY_API_VERSION=2026-07
# Customer metafield that holds the link to the latest quote
SHOPIFY_METAFIELD_NAMESPACE=visit
SHOPIFY_METAFIELD_KEY=last_quote_url
SHOPIFY_METAFIELD_TYPE=url
# Comma separated, added to every draft order
SHOPIFY_DRAFT_ORDER_TAGS=quote-quiz

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Visit.org <quotes@visit.org>
MAIL_REPLY_TO=
MAIL_SUBJECT=Your Impact Kit quote
# Digits shown in front of the draft order's number in the email, so #D15 reads as #1115
MAIL_QUOTE_NUMBER_PREFIX=11

# Email branding
BRAND_NAME=Visit.org
BRAND_URL=https://shop.visit.org
# Logo at the top of the email, about 170px wide (a 2x file keeps it sharp). Empty shows the name instead.
BRAND_LOGO_URL=https://cdn.shopify.com/s/files/1/0744/2264/8995/files/logo_0a354ad3-c06b-4c62-8ce5-4c3506689df8.png?v=1790144701&width=340
BRAND_SUPPORT_EMAIL=

# Log: one JSON line per record, emptied once it holds LOG_MAX_RECORDS lines
LOG_FILE=logs/quotes.log
LOG_MAX_RECORDS=100
